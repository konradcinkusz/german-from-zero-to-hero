#!/usr/bin/env bash
# pre-commit: secret scan, then the source gates. Both read the source and take seconds.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config="$ROOT/.gitleaks.toml" --no-banner --redact 2>/dev/null \
    || gitleaks git --pre-commit --staged --config="$ROOT/.gitleaks.toml" --no-banner --redact
else
  echo "pre-commit: gitleaks is not installed. Install it (https://github.com/gitleaks/gitleaks) or commit with --no-verify; CI will still scan." >&2
  exit 1
fi
python3 "$ROOT/tools/gen.py" --check
python3 "$ROOT/tools/check_book.py"
